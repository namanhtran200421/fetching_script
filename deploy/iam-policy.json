{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectPipelineBuckets",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": [
        "arn:aws:s3:::RAW_BUCKET_NAME",
        "arn:aws:s3:::CLEANED_BUCKET_NAME"
      ]
    },
    {
      "Sid": "ReadRawPipelineObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::RAW_BUCKET_NAME/raw/*"
    },
    {
      "Sid": "WriteRawPipelineObjects",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::RAW_BUCKET_NAME/raw/*"
    },
    {
      "Sid": "WriteCleanedPipelineObjects",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::CLEANED_BUCKET_NAME/cleaned/*",
        "arn:aws:s3:::CLEANED_BUCKET_NAME/quarantine/*"
      ]
    }
  ]
}
