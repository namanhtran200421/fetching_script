[Unit]
Description=WordPress ingestion, cleaning, and RAG preparation
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/fetching-script
EnvironmentFile=/etc/fetching-script.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/fetching-script/.venv/bin/python -m app.jobs.run_pipeline
TimeoutStartSec=0
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
