[Unit]
Description=WordPress ingestion fetch
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/fetching-script
EnvironmentFile=/etc/fetching-script.env
ExecStart=/opt/fetching-script/.venv/bin/python -m app.jobs.run_ingestion
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
