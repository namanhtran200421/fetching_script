WORDPRESS_BASE_URL=https://example.com
WORDPRESS_USERNAME=your-wordpress-username
WORDPRESS_APP_PASSWORD=your-wordpress-application-password
MEC_API_TOKEN=your-mec-api-token

# Use "s3" on EC2 for durable storage, or "local" for local JSON files.
STORAGE_MODE=s3
S3_BUCKET_NAME=your-ingestion-bucket
LOCAL_DATA_DIR=/opt/fetching-script/data/raw

# Blank or "all" resolves every MEC event. Use a positive integer for testing.
MAX_CALENDAR_EVENTS=all
HTTP_TIMEOUT_SECONDS=50
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF_SECONDS=1
